#!/bin/sh
# Starts asciijump from an av install: points it at the gfx/ and hills/
# folders next to this script, then runs the real binary in lib/. Hill
# records go to ~/.asciijump/ (see PATCHES.md).
# av links ~/.local/bin/asciijump to this file, so follow that link first.
self=$(readlink "$0" 2>/dev/null || printf '%s' "$0")
dir=$(cd "$(dirname "$self")" && pwd)
ASCIIJUMP_DATADIR="$dir" exec "$dir/lib/asciijump" "$@"
